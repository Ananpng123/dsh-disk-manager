{
  "name": "dsh-disk-manager",
  "version": "0.2.0",
  "description": "A Windows disk manager for the DeepSeek Harness right sidebar: volume overview, folder browsing, on-demand folder sizes, desktop shortcuts with real app icons, and three-level hover previews.",
  "type": "module",
  "license": "MIT",
  "author": "dsh-disk-manager contributors",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "disk",
    "volume",
    "file-manager",
    "explorer",
    "folder-size",
    "sidebar",
    "windows"
  ],
  "homepage": "https://github.com/Ananpng123/dsh-disk-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ananpng123/dsh-disk-manager.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/Ananpng123/dsh-disk-manager/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "icon.svg",
    "index.json",
    "package.json",
    "cordis.patch.yml",
    "index.js",
    "client.js",
    "test/"
  ],
  "scripts": {
    "test": "node test/smoke.mjs",
    "test:market": "node test/market.mjs",
    "test:leaks": "node test/leaks.mjs",
    "check": "node --check index.js && node --check client.js",
    "prepublishOnly": "npm run check && npm run test && npm run test:leaks && npm run test:market"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  }
}
